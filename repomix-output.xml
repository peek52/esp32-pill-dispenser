        // --- NETPIE ---
        function saveData() {
            const btn = document.getElementById('save-txt');
            const orig = btn.innerText;

            // Validation
            if (typeof microgear === 'undefined' || !microgear["esp32cam_dispenser"]) {
                alert("⚠️ Offline: Cannot connect to NETPIE");
                return;
            }

            btn.innerText = "กำลังส่ง...";
            try {
                let p = {};
                p.scheduleEnabled = document.getElementById('master').checked ? 1 : 0;

                // Times
                TIME_KEYS.forEach(k => {
                    let el = document.getElementById(k);
                    if (el) p[k] = el.value;
                });

                // Modules
                modules.forEach(m => {
                    upd(m.id);
                    p[`med${m.id}_name`] = m.name;
                    p[`med${m.id}_count`] = m.count;
                    p[`med${m.id}_slots`] = m.slots;
                });

                // Send
                const target = microgear["esp32cam_dispenser"];
                for (let k in p) target.writeShadow(k, p[k]);

                btn.innerText = "✅ เรียบร้อย";
                setTimeout(() => btn.innerText = orig, 2000);

            } catch (e) {
                btn.innerText = "❌ ผิดพลาด";
                alert("Error: " + e.message);
            }
        }

        function syncLoop() {
            if (typeof datasources === 'undefined' || !datasources["esp32cam_dispenser"]) return;
            let s = datasources["esp32cam_dispenser"]["shadow"];
            if (!s) return;

            if (s.scheduleEnabled != null) document.getElementById('master').checked = (s.scheduleEnabled == 1);

            TIME_KEYS.forEach(k => {
                let el = document.getElementById(k);
                if (el && document.activeElement !== el && s[k]) el.value = s[k];
            });

            modules.forEach(m => {
                if (s[`med${m.id}_name`] !== undefined) {
                    m.name = s[`med${m.id}_name`];
                    let el = document.getElementById(`n-${m.id}`);
                    if (el && document.activeElement !== el) el.value = m.name;
                }
                if (s[`med${m.id}_count`] != null) m.count = parseInt(s[`med${m.id}_count`]);
                if (s[`med${m.id}_slots`] != null) m.slots = parseInt(s[`med${m.id}_slots`]);
                refresh(m.id);
            });
        }

        init();
    </script>
</body>

</html>
