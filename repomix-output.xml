    <script>
        // --- DATA ---
        const TIME_KEYS = ["t_morn_pre", "t_morn_post", "t_noon_pre", "t_noon_post", "t_eve_pre", "t_eve_post", "t_bed"];
        const SLOT_LABELS = ["เช้า-ก่อน", "เช้า-หลัง", "เที่ยง-ก่อน", "เที่ยง-หลัง", "เย็น-ก่อน", "เย็น-หลัง", "นอน"];
        var modules = Array.from({ length: 6 }, (_, i) => ({ id: i + 1, name: "", count: 0, slots: 0 }));

        function init() {
            // Safety Check: Check if context is available
            if (typeof microgear === 'undefined' && typeof datasources === 'undefined') {
                console.warn("⚠️ Running outside NETPIE environment or loading...");
            }
            // Render Modules
            let html = "";
            modules.forEach(m => {
                html += `
            <div class="mod-item">
                <div class="mod-header-row">
                    <span class="mod-title">ตลับที่ ${m.id}</span>
                    <div class="qty-control">
                        <button class="qty-btn" onclick="step(${m.id},-1)">-</button>
