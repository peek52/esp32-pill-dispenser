#include "scheduler.h"
#include "config.h"
#include "logging.h"
#include "netpie.h"
#include <WiFi.h>
#include <time.h>

// ============================================
// Scheduler Implementation
// ============================================

// Schedule data (7 slots)
TimeSlot scheduleSlots[7];


// RTC
RTC_DS3231 rtc;

// Callback
static ScheduleTriggerCallback onScheduleTrigger = nullptr;

// Tracking
static unsigned long lastNtpSync = 0;
static int lastCheckedMinute = -1;

void setScheduleTriggerCallback(ScheduleTriggerCallback callback) {
  onScheduleTrigger = callback;
}

// --- Update Schedule Time ---
void updateScheduleTime(int index, int h, int m, bool active) {
  if (index >= 0 && index < 7) {
    scheduleSlots[index].hour = h;
    scheduleSlots[index].minute = m;
    scheduleSlots[index].active = active;
    
    // Default labels if empty
    if (scheduleSlots[index].label == "") {
      switch(index) {
        case 0: scheduleSlots[index].label = "เช้า (ก่อน)"; break;
        case 1: scheduleSlots[index].label = "เช้า (หลัง)"; break;
        case 2: scheduleSlots[index].label = "กลางวัน (ก่อน)"; break;
        case 3: scheduleSlots[index].label = "กลางวัน (หลัง)"; break;
        case 4: scheduleSlots[index].label = "เย็น (ก่อน)"; break;
        case 5: scheduleSlots[index].label = "เย็น (หลัง)"; break;
        case 6: scheduleSlots[index].label = "ก่อนนอน"; break;
      }
    }
    LOG_INFO("[Scheduler] Updated Slot %d: %02d:%02d (%s)", index, h, m, active ? "ON" : "OFF");
  }
}

// --- Parse Time String "HH:MM" ---
void parseTimeString(String timeStr, int &h, int &m) {
  int idx = timeStr.indexOf(':');
  if (idx != -1) {
    h = timeStr.substring(0, idx).toInt();
    m = timeStr.substring(idx + 1).toInt();
  }
}

String formatTime(int h, int m) {
  static char buffer[8];
  snprintf(buffer, sizeof(buffer), "%02d:%02d", h, m);
  return String(buffer);
}

// --- Setup ---
void schedulerSetup() {
  if (!rtc.begin()) {
    LOG_ERROR("[Scheduler] RTC not found!");
  } else {
    LOG_INFO("[Scheduler] RTC initialized");
    
    DateTime now = rtc.now();
    LOG_INFO("[Scheduler] RTC Time: %04d-%02d-%02d %02d:%02d:%02d",
             now.year(), now.month(), now.day(),
             now.hour(), now.minute(), now.second());
  }
}

// --- Sync RTC with NTP (non-blocking call) ---
void syncRTCWithNTP() {
  if (WiFi.status() != WL_CONNECTED) return;
  
  LOG_INFO("[Scheduler] Syncing RTC with NTP...");
  
  // ตั้งค่า NTP อีกครั้ง (กรณียังไม่ได้ตั้ง)
  configTime(GMT_OFFSET_SEC, DAYLIGHT_OFFSET_SEC, NTP_SERVER);
  
  struct tm timeinfo;
  
  // ลอง 3 ครั้ง
  for (int i = 0; i < 3; i++) {
    if (getLocalTime(&timeinfo, 10000)) {  // timeout 10 วินาที
      rtc.adjust(DateTime(
        timeinfo.tm_year + 1900,
        timeinfo.tm_mon + 1,
        timeinfo.tm_mday,
        timeinfo.tm_hour,
        timeinfo.tm_min,
        timeinfo.tm_sec
      ));
      lastNtpSync = millis();
      
      LOG_INFO("[Scheduler] NTP Sync OK: %04d-%02d-%02d %02d:%02d:%02d",
               timeinfo.tm_year + 1900, timeinfo.tm_mon + 1, timeinfo.tm_mday,
               timeinfo.tm_hour, timeinfo.tm_min, timeinfo.tm_sec);
      return;
    }
    LOG_WARN("[Scheduler] NTP attempt %d failed, retrying...", i + 1);
  }
  
  LOG_ERROR("[Scheduler] NTP Sync Failed after 3 attempts");
}

// --- Check Schedule (non-blocking) ---
void checkSchedule() {
  if (!scheduleEnabled) return;
  
  DateTime now = rtc.now();
  int h = now.hour();
  int m = now.minute();
  int s = now.second();
  
  // เช็คเฉพาะวินาทีที่ 0 และนาทีที่ยังไม่เช็ค
  if (s != 0 || m == lastCheckedMinute) return;
  lastCheckedMinute = m;
  
  LOG_DEBUG("[Scheduler] Checking %02d:%02d", h, m);
  
  // Iterate all 7 slots
  for(int i=0; i<7; i++) {
    if (scheduleSlots[i].active && h == scheduleSlots[i].hour && m == scheduleSlots[i].minute) {
      LOG_INFO("[Scheduler] >>> SLOT %d TRIGGERED (%s)", i, scheduleSlots[i].label.c_str());
      if (onScheduleTrigger) onScheduleTrigger(i, scheduleSlots[i].label);
    }
  }
}

// --- Scheduler Loop (non-blocking) ---
void schedulerLoop() {
  // NTP sync ทุก 1 ชั่วโมง
  if (millis() - lastNtpSync > NTP_SYNC_INTERVAL) {
    syncRTCWithNTP();
  }
  
  // เช็คตารางเวลา
  checkSchedule();
}
</file>

