        // อ่านค่าจาก Shadow
        var medicineName = "${#["esp32cam_dispenser"]["shadow"]["medicineName"]}";
        var scheduleEnabled = ${#["esp32cam_dispenser"]["shadow"]["scheduleEnabled"] };

        var dose1_time = "${#["esp32cam_dispenser"]["shadow"]["dose1_time"]}";
        var dose1_timing = "${#["esp32cam_dispenser"]["shadow"]["dose1_timing"]}";

        var dose2_time = "${#["esp32cam_dispenser"]["shadow"]["dose2_time"]}";
        var dose2_timing = "${#["esp32cam_dispenser"]["shadow"]["dose2_timing"]}";

        var dose3_time = "${#["esp32cam_dispenser"]["shadow"]["dose3_time"]}";
        var dose3_timing = "${#["esp32cam_dispenser"]["shadow"]["dose3_timing"]}";

        var dose4_time = "${#["esp32cam_dispenser"]["shadow"]["dose4_time"]}";

        function getTimingText(timing) {
            if (timing === "before") return "ก่อนอาหาร";
            if (timing === "after") return "หลังอาหาร";
            return "";
        }

        function updateDisplay() {
            // แสดงชื่อยา
            if (medicineName && medicineName !== "undefined" && medicineName !== "ยา") {
                document.getElementById('medNameDisplay').innerHTML = '<span>💊</span><span>' + medicineName + '</span>';
            }

            // แสดงสถานะ
            var badge = document.getElementById('statusBadge');
            if (scheduleEnabled == 1) {
                badge.className = 'status-badge on';
                badge.innerHTML = '<span>🟢</span><span>เปิดใช้งาน</span>';
            } else {
                badge.className = 'status-badge off';
                badge.innerHTML = '<span>🔴</span><span>ปิดใช้งาน</span>';
            }

            // สร้างลิสต์ตาราง
            var html = '';
            var count = 0;

            var doses = [
                { time: dose1_time, timing: dose1_timing, label: 'เช้า', icon: '🌅', class: 'morning' },
                { time: dose2_time, timing: dose2_timing, label: 'กลางวัน', icon: '☀️', class: 'noon' },
                { time: dose3_time, timing: dose3_timing, label: 'เย็น', icon: '🌆', class: 'evening' },
                { time: dose4_time, timing: 'none', label: 'ก่อนนอน', icon: '🌙', class: 'bedtime' }
            ];

            doses.forEach(function (dose) {
                if (dose.time && dose.time !== "undefined") {
                    var timingText = getTimingText(dose.timing);
                    html += '<div class="schedule-item ' + dose.class + '">';
                    html += '<div class="schedule-item-left">';
                    html += '<span class="schedule-icon">' + dose.icon + '</span>';
                    html += '<div class="schedule-info">';
                    html += '<div class="schedule-item-label">' + dose.label + '</div>';
                    if (timingText) {
                        html += '<div class="schedule-item-timing">' + timingText + '</div>';
                    }
                    html += '</div>';
                    html += '</div>';
                    html += '<div class="schedule-item-time">' + dose.time + '</div>';
                    html += '</div>';
                    count++;
                }
            });

            if (count === 0) {
                html = '<div class="empty-schedule">';
                html += '<div class="empty-schedule-icon">💊</div>';
                html += '<div class="empty-schedule-text">';
                html += 'ยังไม่มีตารางการจ่ายยา<br>';
                html += '<span style="font-size: 10px; color: #ccc;">กรุณาตั้งค่าจากหน้าหลัก</span>';
                html += '</div></div>';
            }

            document.getElementById('scheduleListContent').innerHTML = html;
        }

        updateDisplay();
    </script>
</body>

