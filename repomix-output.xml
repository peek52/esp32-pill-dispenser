<body>
    <div class="card">
        <div class="header">
            <div class="header-left">
                <span class="header-icon">💊</span>
                <span class="header-title">ตั้งเวลาจ่ายยา (ตลับ 1)</span>
            </div>
            <label class="toggle">
                <input type="checkbox" id="scheduleEnabled" onchange="toggleSchedule()">
                <span class="slider"></span>
            </label>
        </div>

        <div class="content">
            <div class="medicine-section">
                <div class="medicine-label">ชื่อยา (ตลับ 1)</div>
                <input type="text" class="medicine-input" id="medicineNameInput" placeholder="กรอกชื่อยา..."
                    value="Paracetamol" onchange="updateMedicineName()">
            </div>

            <button class="btn-dispense" onclick="dispenseNow()">
                <span>🏥</span>
                <span>จ่ายยาทันที (ตลับ 1)</span>
            </button>

            <div class="section-title">
                <span>⏰</span>
                <span>ตารางเวลา</span>
            </div>

            <div class="dose-grid">
                <!-- Morning -->
                <div class="dose-card">
                    <div class="dose-header">
                        <span class="dose-icon">🌅</span>
                        <span class="dose-label morning">เช้า</span>
                    </div>
                    <div class="dose-field">
                        <label class="field-label">เวลา</label>
                        <input type="time" id="dose1_time" value="08:00">
                    </div>
                    <div class="dose-field">
                        <label class="field-label">ช่วงเวลา</label>
                        <select id="dose1_timing">
                            <option value="before">ก่อนอาหาร</option>
                            <option value="after" selected>หลังอาหาร</option>
                        </select>
                    </div>
                </div>

                <!-- Noon -->
                <div class="dose-card">
                    <div class="dose-header">
                        <span class="dose-icon">☀️</span>
                        <span class="dose-label noon">กลางวัน</span>
                    </div>
                    <div class="dose-field">
                        <label class="field-label">เวลา</label>
                        <input type="time" id="dose2_time" value="12:00">
                    </div>
                    <div class="dose-field">
                        <label class="field-label">ช่วงเวลา</label>
                        <select id="dose2_timing">
                            <option value="before" selected>ก่อนอาหาร</option>
                            <option value="after">หลังอาหาร</option>
                        </select>
                    </div>
                </div>

                <!-- Evening -->
                <div class="dose-card">
                    <div class="dose-header">
                        <span class="dose-icon">🌆</span>
                        <span class="dose-label evening">เย็น</span>
                    </div>
                    <div class="dose-field">
                        <label class="field-label">เวลา</label>
                        <input type="time" id="dose3_time" value="19:00">
                    </div>
                    <div class="dose-field">
                        <label class="field-label">ช่วงเวลา</label>
                        <select id="dose3_timing">
                            <option value="before">ก่อนอาหาร</option>
                            <option value="after" selected>หลังอาหาร</option>
                        </select>
                    </div>
                </div>

                <!-- Bedtime -->
                <div class="dose-card">
                    <div class="dose-header">
                        <span class="dose-icon">🌙</span>
                        <span class="dose-label bedtime">ก่อนนอน</span>
                    </div>
                    <div class="dose-field">
                        <label class="field-label">เวลา</label>
                        <input type="time" id="dose4_time" value="22:00">
                    </div>
                    <div class="dose-field">
                        <label class="field-label">ช่วงเวลา</label>
                        <select id="dose4_timing" disabled>
                            <option value="none">-</option>
                        </select>
                    </div>
                </div>
            </div>

            <button class="btn-save" id="btnSave" onclick="saveSchedule()">
                <span>💾</span>
                <span>บันทึกตารางเวลา</span>
            </button>
        </div>
    </div>

    <script>
        // อ่านค่าจาก Shadow - Map 6-Module Firmware Keys
        var med1_name = "${#["esp32cam_dispenser"]["shadow"]["med1_name"]}";
        var scheduleEnabled = ${#["esp32cam_dispenser"]["shadow"]["scheduleEnabled"] };
        var med1_slots = ${#["esp32cam_dispenser"]["shadow"]["med1_slots"] };

        // Note: Global Times (t_morn_pre etc.) are not easily mapped back to this single view
        // We will stick to write-only mainly for this simplified widget OR rely on user re-entering.

        function initFromShadow() {
            // ชื่อยา
            if (med1_name && med1_name !== "undefined" && med1_name !== "ยา") {
                document.getElementById('medicineNameInput').value = med1_name;
            }

            // สวิตช์
            document.getElementById('scheduleEnabled').checked = (scheduleEnabled == 1);
        }

        // Debounce timer
        var updateTimer = null;

        function updateMedicineName() {
            var name = document.getElementById('medicineNameInput').value;
            if (name && name.trim() !== "") {
                // Debounce - รอ 500ms ก่อนส่ง
                clearTimeout(updateTimer);
                updateTimer = setTimeout(function () {
                    // Update: med1_name
                    #["esp32cam_dispenser"].writeShadow("med1_name", name);
                }, 500);
            }
        }

        function toggleSchedule() {
            var enabled = document.getElementById('scheduleEnabled').checked ? 1 : 0;
            // ส่งทันที (ไม่ debounce)
            // Update: scheduleEnabled
            #["esp32cam_dispenser"].writeShadow("scheduleEnabled", enabled);
        }

        function dispenseNow() {
            // Update: dispense_1 (Module 1 Manual Dispense)
            #["esp32cam_dispenser"].writeShadow("dispense_1", 1);
            setTimeout(function () {
                #["esp32cam_dispenser"].writeShadow("dispense_1", 0);
            }, 500);
        }

        function saveSchedule() {
            var btn = document.getElementById('btnSave');
            var originalHTML = btn.innerHTML;
            btn.innerHTML = '<span>⏳</span><span>กำลังบันทึก...</span>';

            // 1. Calculate Slots for Module 1
            var slots = 0;
            var t1 = document.getElementById('dose1_timing').value;
            if (t1 === 'before') slots |= (1 << 0);
            if (t1 === 'after') slots |= (1 << 1);

            var t2 = document.getElementById('dose2_timing').value;
            if (t2 === 'before') slots |= (1 << 2);
            if (t2 === 'after') slots |= (1 << 3);

            var t3 = document.getElementById('dose3_timing').value;
            if (t3 === 'before') slots |= (1 << 4);
            if (t3 === 'after') slots |= (1 << 5);

            // Bedtime (Assuming always enabled for this card)
            slots |= (1 << 6);

            // 2. Prepare Data Packet (Using Firmware Keys)
            var shadowData = {
                // Module 1 Config
                med1_name: document.getElementById('medicineNameInput').value,
                med1_count: 18,
                med1_slots: slots,
                scheduleEnabled: document.getElementById('scheduleEnabled').checked ? 1 : 0,

                // Global Times
                t_bed: document.getElementById('dose4_time').value
            };

            // 3. Conditional Global Times Map
            // Map inputs to specific global keys
            var time1 = document.getElementById('dose1_time').value;
            if (t1 === 'before') shadowData.t_morn_pre = time1;
            else shadowData.t_morn_post = time1;

            var time2 = document.getElementById('dose2_time').value;
            if (t2 === 'before') shadowData.t_noon_pre = time2;
            else shadowData.t_noon_post = time2;

            var time3 = document.getElementById('dose3_time').value;
            if (t3 === 'before') shadowData.t_eve_pre = time3;
            else shadowData.t_eve_post = time3;

            // Debug Payload Check
            // alert("DEBUG: " + JSON.stringify(shadowData)); // Uncomment to debug

            // 4. Send to NETPIE (Single Object - Trusted method)
            #["esp32cam_dispenser"].writeShadow(shadowData);

            setTimeout(function () {
                btn.innerHTML = '<span>✅</span><span>บันทึกตลับ 1 เรียบร้อย!</span>';
                setTimeout(function () {
                    btn.innerHTML = originalHTML;
                }, 2000);
            }, 500);
        }

        initFromShadow();
    </script>
</body>

</html>
