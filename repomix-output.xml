            <button class="btn-save" id="btnSave" onclick="saveSchedule()">
                <span>💾</span><span>บันทึกตารางเวลา</span>
            </button>
        </div>
    </div>

    <script>
        var medicineName = "${#["esp32cam_dispenser"]["shadow"]["medicineName"]}";
        var scheduleEnabled = ${#["esp32cam_dispenser"]["shadow"]["scheduleEnabled"] };

        var dose1_time = "${#["esp32cam_dispenser"]["shadow"]["dose1_time"]}";
        var dose1_timing = "${#["esp32cam_dispenser"]["shadow"]["dose1_timing"]}";

        var dose2_time = "${#["esp32cam_dispenser"]["shadow"]["dose2_time"]}";
        var dose2_timing = "${#["esp32cam_dispenser"]["shadow"]["dose2_timing"]}";

        var dose3_time = "${#["esp32cam_dispenser"]["shadow"]["dose3_time"]}";
        var dose3_timing = "${#["esp32cam_dispenser"]["shadow"]["dose3_timing"]}";

        var dose4_time = "${#["esp32cam_dispenser"]["shadow"]["dose4_time"]}";

        function initFromShadow() {
            if (medicineName && medicineName !== "undefined" && medicineName !== "ยา") {
                document.getElementById('medicineNameInput').value = medicineName;
            }
            document.getElementById('scheduleEnabled').checked = (scheduleEnabled == 1);
            if (dose1_time && dose1_time !== "undefined") document.getElementById('dose1_time').value = dose1_time;
            if (dose1_timing && dose1_timing !== "undefined") document.getElementById('dose1_timing').value = dose1_timing;
            if (dose2_time && dose2_time !== "undefined") document.getElementById('dose2_time').value = dose2_time;
            if (dose2_timing && dose2_timing !== "undefined") document.getElementById('dose2_timing').value = dose2_timing;
            if (dose3_time && dose3_time !== "undefined") document.getElementById('dose3_time').value = dose3_time;
            if (dose3_timing && dose3_timing !== "undefined") document.getElementById('dose3_timing').value = dose3_timing;
            if (dose4_time && dose4_time !== "undefined") document.getElementById('dose4_time').value = dose4_time;
        }

        var updateTimer = null;
        function updateMedicineName() {
            var name = document.getElementById('medicineNameInput').value;
            if (name && name.trim() !== "") {
                clearTimeout(updateTimer);
                updateTimer = setTimeout(function () {
                    #["esp32cam_dispenser"].writeShadow("medicineName", name);
                }, 500);
            }
        }

        function toggleSchedule() {
            var enabled = document.getElementById('scheduleEnabled').checked ? 1 : 0;
            #["esp32cam_dispenser"].writeShadow("scheduleEnabled", enabled);
        }

        function dispenseNow() {
            #["esp32cam_dispenser"].writeShadow("dispenseNow", 1);
            setTimeout(function () {
                #["esp32cam_dispenser"].writeShadow("dispenseNow", 0);
            }, 500);
        }

        function saveSchedule() {
            var btn = document.getElementById('btnSave');
            var originalHTML = btn.innerHTML;
            btn.innerHTML = '<span>⏳</span><span>กำลังบันทึก...</span>';
            var shadowData = {
                medicineName: document.getElementById('medicineNameInput').value,
                dose1_time: document.getElementById('dose1_time').value,
                dose1_timing: document.getElementById('dose1_timing').value,
                dose2_time: document.getElementById('dose2_time').value,
                dose2_timing: document.getElementById('dose2_timing').value,
                dose3_time: document.getElementById('dose3_time').value,
                dose3_timing: document.getElementById('dose3_timing').value,
                dose4_time: document.getElementById('dose4_time').value
            };
            #["esp32cam_dispenser"].writeShadow(shadowData);
            setTimeout(function () {
                btn.innerHTML = '<span>✅</span><span>บันทึกเรียบร้อย!</span>';
                setTimeout(function () {
                    btn.innerHTML = originalHTML;
                }, 2000);
            }, 300);
        }
        initFromShadow();
    </script>
</body>

</html>
