#include "wifi_module.h"
#include "config.h"
#include "logging.h"
#include "offline_module.h" // For syncOfflineQueue
#include <WiFi.h>
#include <WiFiManager.h>

static bool _isOnline = false;
WiFiManager wifiManager;

bool isSystemOnline() {
  return _isOnline;
}

void wifiSetup() {
  LOG_INFO("[WiFi] Starting WiFi Manager...");
  
  wifiManager.setConfigPortalTimeout(120);
  wifiManager.setConnectTimeout(30);
  
  if (!wifiManager.autoConnect(WIFI_AP_NAME)) {
    LOG_WARN("[WiFi] Failed, running in OFFLINE mode");
    _isOnline = false;
    return;
  }
  
  _isOnline = true;
  LOG_INFO("[WiFi] Connected! IP: %s", WiFi.localIP().toString().c_str());
}

void resetWiFi() {
  LOG_WARN("[WiFi] Resetting WiFi settings...");
  wifiManager.resetSettings();
  ESP.restart();
}

String getWiFiSSID() {
  return WiFi.SSID();
}

void checkConnectivity() {
  static unsigned long lastCheck = 0;
  if (millis() - lastCheck < CONNECTION_CHECK_INTERVAL) return;
  lastCheck = millis();
  
  bool wasOnline = _isOnline;
  _isOnline = (WiFi.status() == WL_CONNECTED);
  
  if (!wasOnline && _isOnline) {
    LOG_INFO("[WiFi] Reconnected!");
    syncOfflineQueue();
  } else if (wasOnline && !_isOnline) {
    LOG_WARN("[WiFi] Disconnected, entering OFFLINE mode");
  }
}
