uint16_t getPwm(int angle) {
  angle = constrain(angle, 0, 180);
  long us = map(angle, 0, 180, 500, 2500);
  return (uint16_t)((us * 4096L) / 20000L);
}

void setServo(int angle) {
  pca9685.setPWM(SERVO_CH, 0, getPwm(angle));
}

void updateShadow(String status, String detail) {
  if (!client.connected()) return;
  
  DateTime now = rtc.now();
  char timeStr[20];
  sprintf(timeStr, "%04d-%02d-%02d %02d:%02d:%02d", 
          now.year(), now.month(), now.day(), 
          now.hour(), now.minute(), now.second());
  
  String payload = "{\"data\": {";
  payload += "\"status\": \"" + status + "\",";
  payload += "\"detail\": \"" + detail + "\",";
  payload += "\"time\": \"" + String(timeStr) + "\"";
  payload += "}}";
  client.publish("@shadow/data/update", payload.c_str());
}

// === DISPENSE PILL ===
void dispensePill(String triggerSource) {
  Serial.print("\n>>> Dispensing: ");
  Serial.println(triggerSource);
  
  digitalWrite(LED_PIN, HIGH);
  updateShadow("dispensing", triggerSource);
  
  setServo(27);
  delay(800);
  
  bool detected = false;
  
  #if USE_PCF8574
    // อ่านจาก PCF8574 (รองรับหลาย sensors)
    Serial.println("Checking IR sensors (PCF8574)...");
    for(int i=0; i<20; i++) {
      uint8_t values = pcf8574.read8();  // อ่านทั้ง 8 pins พร้อมกัน
      
      // ตรวจสอบว่ามี sensor ไหนตรวจพบ (LOW = detected)
      for(int s = 0; s < IR_SENSOR_COUNT; s++) {
        if(bitRead(values, IR_PINS[s]) == 0) {
          Serial.printf("  ✓ IR Sensor P%d detected pill!\n", IR_PINS[s]);
          detected = true;
          break;
        }
      }
      
      if(detected) break;
      delay(10);
    }
  #else
    // อ่านจาก GPIO เดี่ยว (โค้ดเดิม)
    Serial.println("Checking IR sensor (GPIO 5)...");
    for(int i=0; i<20; i++) {
      if(digitalRead(IR_PIN) == LOW) {
        detected = true;
        Serial.println("  ✓ IR detected pill!");
        break;
      }
      delay(10);
    }
  #endif
  
  setServo(0);
  delay(1000);
  delay(2000);

  DateTime now = rtc.now();
  char timeStr[10];
  sprintf(timeStr, "%02d:%02d", now.hour(), now.minute());

  if (detected) {
    Serial.println(">>> SUCCESS: Pill Detected");
    updateShadow("success", "OK");
    sendTelegramNotification("✅ จ่ายสำเร็จ: " + triggerSource + " (" + String(timeStr) + ")");
  } else {
    Serial.println(">>> EMPTY: No Pill");
    updateShadow("empty", "No pill");
    sendTelegramNotification("❌ จ่ายไม่สำเร็จ - ยาหมด: " + triggerSource + " (" + String(timeStr) + ")");
  }
  
  digitalWrite(LED_PIN, LOW);
}

