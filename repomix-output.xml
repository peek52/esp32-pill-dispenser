                </div>
            </div>
            <label class="toggle">
                <input type="checkbox" id="lightEnabled" onchange="toggleLight()">
                <span class="slider"></span>
            </label>
        </div>
        <!-- ON Schedule -->
        <div class="schedule-box">
            <div class="schedule-title on">🟢 Turn ON</div>
            <div class="row">
                <div class="field">
                    <span class="field-label">Day</span>
                    <select id="onDay">
                        <option value="0">Sunday</option>
                        <option value="1">Monday</option>
                        <option value="2">Tuesday</option>
                        <option value="3">Wednesday</option>
                        <option value="4">Thursday</option>
                        <option value="5">Friday</option>
                        <option value="6">Saturday</option>
                    </select>
                </div>
                <div class="field">
                    <span class="field-label">Time</span>
                    <input type="time" id="onTime" value="06:00">
                </div>
            </div>
        </div>
        <!-- OFF Schedule -->
        <div class="schedule-box">
            <div class="schedule-title off">🔴 Turn OFF</div>
            <div class="row">
                <div class="field">
                    <span class="field-label">Day</span>
                    <select id="offDay">
                        <option value="0">Sunday</option>
                        <option value="1">Monday</option>
                        <option value="2">Tuesday</option>
                        <option value="3">Wednesday</option>
                        <option value="4">Thursday</option>
                        <option value="5">Friday</option>
                        <option value="6">Saturday</option>
                    </select>
                </div>
                <div class="field">
                    <span class="field-label">Time</span>
                    <input type="time" id="offTime" value="18:00">
                </div>
            </div>
        </div>
        <button class="btn-save" id="btnSave" onclick="saveSchedule()">💾 Save Schedule</button>
        <div class="hint">Example: Mon 16:00 → Sun 16:00 = 6 days ON</div>
    </div>
    <script>
        var currentEnabled = ${#["Esp32s3"]["shadow"]["lightEnabled"]};
        var currentOnDay = ${#["Esp32s3"]["shadow"]["lightOnDay"]};
        var currentOnTime = "${#["Esp32s3"]["shadow"]["lightOnTime"]}";
        var currentOffDay = ${#["Esp32s3"]["shadow"]["lightOffDay"]};
        var currentOffTime = "${#["Esp32s3"]["shadow"]["lightOffTime"]}";
        
        function initFromShadow() {
            document.getElementById('lightEnabled').checked = (currentEnabled == 1);
            updateStatusText(currentEnabled == 1);
            document.getElementById('onDay').value = (!isNaN(currentOnDay)) ? currentOnDay : 1;
            document.getElementById('onTime').value = (currentOnTime && currentOnTime != "undefined") ? currentOnTime : "06:00";
            document.getElementById('offDay').value = (!isNaN(currentOffDay)) ? currentOffDay : 0;
            document.getElementById('offTime').value = (currentOffTime && currentOffTime != "undefined") ? currentOffTime : "18:00";
        }
        
        function updateStatusText(enabled) {
            var el = document.getElementById('statusText');
            el.textContent = enabled ? '🟢 Schedule Active' : '⚪ Manual Mode';
            el.className = enabled ? 'status-text on' : 'status-text off';
        }
        
        function toggleLight() {
            var enabled = document.getElementById('lightEnabled').checked ? 1 : 0;
            #["Esp32s3"].writeShadow("lightEnabled", enabled);
            updateStatusText(enabled == 1);
        }
        
        function saveSchedule() {
            var btn = document.getElementById('btnSave');
            btn.textContent = '⏳ Saving...';
            
            #["Esp32s3"].writeShadow("lightOnDay", parseInt(document.getElementById('onDay').value));
            #["Esp32s3"].writeShadow("lightOnTime", document.getElementById('onTime').value);
            #["Esp32s3"].writeShadow("lightOffDay", parseInt(document.getElementById('offDay').value));
            #["Esp32s3"].writeShadow("lightOffTime", document.getElementById('offTime').value);
            
            setTimeout(function() {
                btn.textContent = '✅ Saved!';
                setTimeout(function() { btn.textContent = '💾 Save Schedule'; }, 2000);
            }, 300);
        }
        
        initFromShadow();
    </script>
</body>
</html>
