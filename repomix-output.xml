#include "dispenser.h"
#include "config.h"
#include "logging.h"
#include "netpie.h"
#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>

#if USE_PCF8574
  #include <PCF8574.h>
  PCF8574 pcf8574(PCF8574_ADDRESS);
  const uint8_t IR_PINS[IR_SENSOR_COUNT] = {0, 1, 2, 3, 4, 5};
#endif

// ============================================
// Dispenser Implementation
// ============================================

Adafruit_PWMServoDriver pca9685 = Adafruit_PWMServoDriver(PCA9685_ADDRESS);

static DispenseCompleteCallback onDispenseComplete = nullptr;

// --- Dispense State Machine ---
enum DispenseState { IDLE, OPENING, DETECTING, CLOSING, COMPLETE };
static DispenseState dispenseState = IDLE;
static unsigned long stateTimer = 0;
static String currentTrigger = "";
static bool pillDetected = false;

void setDispenseCompleteCallback(DispenseCompleteCallback callback) {
  onDispenseComplete = callback;
}

// --- Setup ---
void dispenserSetup() {
  #if USE_PCF8574
    pcf8574.begin();
    for(int i = 0; i < IR_SENSOR_COUNT; i++) {
      pcf8574.pinMode(IR_PINS[i], INPUT_PULLUP);
    }
    LOG_INFO("[Dispenser] PCF8574 ready with %d IR sensors", IR_SENSOR_COUNT);
  #else
    pinMode(IR_PIN, INPUT);
    LOG_INFO("[Dispenser] IR Sensor on GPIO %d", IR_PIN);
  #endif
  
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);
  
  if (!pca9685.begin()) {
    LOG_ERROR("[Dispenser] PCA9685 Not Found!");
  } else {
    pca9685.setPWMFreq(SERVO_FREQ);
    LOG_INFO("[Dispenser] PCA9685 ready");
  }
  
  // Reset all servos to home
  for(int i=0; i<6; i++) {
    setServo(i, SERVO_ANGLE_HOME);
  }
}

// --- PWM Calculation ---
uint16_t getPwm(int angle) {
  angle = constrain(angle, 0, 180);
  long us = map(angle, 0, 180, 500, 2500);
  return (uint16_t)((us * 4096L) / 20000L);
}

void setServo(int channel, int angle) {
  pca9685.setPWM(channel, 0, getPwm(angle));
}

// --- IR Sensor ---
bool checkIRSensor(int channel) {
  #if USE_PCF8574
    if (channel >= 0 && channel < IR_SENSOR_COUNT) {
      return pcf8574.digitalRead(IR_PINS[channel]) == LOW;
    }
    return false;
  #else
    return digitalRead(IR_PIN) == LOW;
  #endif
}

bool checkPillDetected(int moduleIndex) {
  return checkIRSensor(moduleIndex);
}

// --- Dispense (Non-blocking State Machine) ---
// --- Dispense (Non-blocking State Machine) ---
int currentModuleIndex = -1;

void dispensePill(int moduleIndex, String triggerSource) {
  if (dispenseState != IDLE) {
    LOG_WARN("[Dispenser] Already dispensing, ignoring module %d", moduleIndex);
    return;
  }
  
  if (moduleIndex < 0 || moduleIndex >= 6) {
    LOG_ERROR("[Dispenser] Invalid module index: %d", moduleIndex);
    return;
  }

  LOG_INFO("[Dispenser] >>> Triggered Module %d by: %s", moduleIndex + 1, triggerSource.c_str());
  currentTrigger = triggerSource;
  currentModuleIndex = moduleIndex;
  pillDetected = false;
  
  // เริ่ม state machine
  digitalWrite(LED_PIN, HIGH);
  updateShadow("dispensing", "Trigger: " + triggerSource + " (Mod " + String(moduleIndex+1) + ")");
  
  // Use correct servo channel based on index
  int servoChannel = moduleIndex; // Assuming 0-5 mapping
  pca9685.setPWM(servoChannel, 0, getPwm(SERVO_ANGLE_DISPENSE));
  
  dispenseState = OPENING;
  stateTimer = millis();
}

// --- Non-blocking Loop ---
void dispenserLoop() {
  switch (dispenseState) {
    case IDLE:
      // ไม่ทำอะไร
      break;
      
    case OPENING:
      // รอ servo เปิด (800ms)
      if (millis() - stateTimer > 800) {
        dispenseState = DETECTING;
        stateTimer = millis();
      }
      break;
      
    case DETECTING:
      // เช็ค IR sensor (สูงสุด 200ms)
      if (checkPillDetected(currentModuleIndex)) {
        pillDetected = true;
        dispenseState = CLOSING;
        stateTimer = millis();
      } else if (millis() - stateTimer > 200) {
        dispenseState = CLOSING;
        stateTimer = millis();
      }
      break;
      
    case CLOSING:
      // ปิด servo กลับตำแหน่งเดิม
      if (currentModuleIndex >= 0) {
        int servoChannel = currentModuleIndex;
        pca9685.setPWM(servoChannel, 0, getPwm(SERVO_ANGLE_HOME));
      }
      
      if (millis() - stateTimer > 500) {
        dispenseState = COMPLETE;
      }
      break;
      
    case COMPLETE:
      digitalWrite(LED_PIN, LOW);
      
      if (pillDetected) {
        LOG_INFO("[Dispenser] SUCCESS: Pill Detected");
        updateShadow("success", "Pill Dispensed OK");
      } else {
        LOG_WARN("[Dispenser] EMPTY: No Pill Detected");
        updateShadow("empty", "No pill detected");
      }
      
      if (onDispenseComplete) {
        onDispenseComplete(pillDetected, currentModuleIndex, currentTrigger);
      }
      
      dispenseState = IDLE;
      break;
  }
}
</file>

<file path="src/main.cpp">
// ============================================
// ESP32 Medicine Dispenser - Main
// Skill Compliant: No delay(), Offline Mode
// ============================================

#include <Arduino.h>
#include <Wire.h>
#include <ArduinoJson.h>

// --- Project Modules ---
#include "config.h"
#include "secrets.h"
#include "logging.h"
#include "netpie.h"
#include "dispenser.h"
#include "scheduler.h"
#include "telegram.h"
#include "wifi_module.h"
#include "offline_module.h"
#include "telegram_messages.h"

// ============================================
// Callbacks
// ============================================

// --- Global Schedule & Module Config ---
struct GlobalTime {
  uint8_t hour = 0;
  uint8_t minute = 0;
  String label = "";
};

GlobalTime globalTimes[7]; // 0=MornPre, 1=MornPost, ... 6=Bed
String timeLabels[7] = {
  "เช้า (ก่อนอาหาร)", "เช้า (หลังอาหาร)",
  "กลางวัน (ก่อนอาหาร)", "กลางวัน (หลังอาหาร)",
  "เย็น (ก่อนอาหาร)", "เย็น (หลังอาหาร)",
  "ก่อนนอน"
};

struct ModuleConfig {
  String name = "ยา " + String(1);
  int count = 18;
  uint8_t slots = 0; // Bitmask for 7 slots
};

ModuleConfig modules[6];
bool scheduleEnabled = true;

// Helper to parse time string "HH:mm"
void parseGlobalTime(String timeStr, int index) {
  if (timeStr.length() < 5) return;
  globalTimes[index].hour = timeStr.substring(0, 2).toInt();
  globalTimes[index].minute = timeStr.substring(3, 5).toInt();
  globalTimes[index].label = timeLabels[index];
}

// Flag for pending confirmation (Bitmask 0-5)
uint8_t pendingDispenseMask = 0;

// เมื่อได้รับข้อมูล schedule จาก NETPIE
void onScheduleUpdate(JsonDocument& doc) {
  LOG_INFO("[Main] Processing 6-Module Schedule...");
  JsonObject data = doc["data"];

  // 1. Parse Global Times
  String timeKeys[] = {"t_morn_pre", "t_morn_post", "t_noon_pre", "t_noon_post", "t_eve_pre", "t_eve_post", "t_bed"};
  for (int i = 0; i < 7; i++) {
    if (data[timeKeys[i]].is<String>()) {
      parseGlobalTime(data[timeKeys[i]].as<String>(), i);
      updateScheduleTime(i, globalTimes[i].hour, globalTimes[i].minute, true);
    }
  }

  // 2. Parse Module Configs
  for (int i = 0; i < 6; i++) {
    String p = "med" + String(i + 1);
    if (data[p + "_name"].is<String>()) modules[i].name = data[p + "_name"].as<String>();
    if (data[p + "_count"].is<int>()) modules[i].count = data[p + "_count"].as<int>();
    if (data[p + "_slots"].is<int>()) modules[i].slots = data[p + "_slots"].as<int>();
  }
  
  // 3. Global Enable
  if (data["scheduleEnabled"].is<int>()) {
    scheduleEnabled = (data["scheduleEnabled"].as<int>() == 1);
  }

  LOG_INFO("=== Schedule Updated ===");
  LOG_INFO("Global Active: %s", scheduleEnabled ? "YES" : "NO");
  for(int i=0; i<6; i++) {
    LOG_INFO("Mod %d: %s (Count: %d, Slots: 0x%02X)", i+1, modules[i].name.c_str(), modules[i].count, modules[i].slots);
  }
}

// เมื่อได้รับคำสั่งจ่ายยาจาก NETPIE (Manual Dispense - Immediate)
void onNetpieDispense(String source) {
  // Format: "dispense_all" or "dispense_1" ... "dispense_6"
  if (source == "dispense_all") {
     for(int i=0; i<6; i++) dispensePill(i, "Manual All");
  } else if (source.startsWith("dispense_")) {
     int modIdx = source.substring(9).toInt() - 1;
     if (modIdx >= 0 && modIdx < 6) {
       dispensePill(modIdx, "Manual Mod " + String(modIdx+1));
     }
  }
}

// เมื่อถึงเวลาจ่ายยาตามตาราง (slotIndex 0-6) -> รอการยืนยัน
void onScheduleTrigger(int slotIndex, String label) {
  if (!scheduleEnabled) return;

  LOG_INFO("[Schedule] Trigger Slot %d: %s", slotIndex, label.c_str());
  
  bool needed = false;
  String pendingMeds = "";

  for (int i = 0; i < 6; i++) {
    // Check if module i is enabled for this slot
    if (modules[i].slots & (1 << slotIndex)) {
      if (modules[i].count > 0) {
        // Mark as pending
        pendingDispenseMask |= (1 << i);
        needed = true;
        pendingMeds += modules[i].name + ", ";
      } else {
        LOG_WARN("[Schedule] Module %d (%s) is EMPTY!", i+1, modules[i].name.c_str());
        sendTelegramNotification("⚠️ ยาหมด: " + modules[i].name);
      }
    }
  }

  // แจ้งเตือนให้มากดยืนยัน
  if (needed) {
    LOG_INFO("[Schedule] Waiting for confirmation...");
    updateShadow("dispensing_status", "waiting_confirm");
    
    if (isSystemOnline()) {
      String msg = String(MSG_TIME_TO_TAKE_PILL) + "\n";
      msg += "มื้อ: " + label + "\n";
      msg += "รอจ่ายยา: " + pendingMeds + "\n";
      msg += "🔘 กรุณากดปุ่มที่เครื่องเพื่อรับยา";
      sendTelegramNotification(msg);
    }
  }
}

// เมื่อจ่ายยาเสร็จ
void onDispenseComplete(bool success, int moduleIndex, String source) {
  String status = success ? "success" : "empty";
  String medName = (moduleIndex >= 0 && moduleIndex < 6) ? modules[moduleIndex].name : "Unknown";
  String detail = success ? "Dispensed: " + medName : "Empty: " + medName;
  
  updateShadowOfflineAware(status, detail);
  
  if (isSystemOnline()) {
    String msg = success ? String(MSG_DISPENSE_SUCCESS) : String(MSG_DISPENSE_FAIL);
    msg += "\n" + medName + " (" + source + ")";
    sendTelegramNotification(msg);
  }
}

// เมื่อได้รับคำสั่งจาก Telegram
void onTelegramCommand(String command) {
  command.toLowerCase();
  
  // Example: /dispense 1
  if (command.startsWith("/dispense") || command.startsWith("จ่ายยา")) {
    int spaceIndex = command.indexOf(' ');
    if (spaceIndex != -1) {
      int modIdx = command.substring(spaceIndex + 1).toInt() - 1;
      if (modIdx >= 0 && modIdx < 6) {
        dispensePill(modIdx, "Telegram Command");
        sendTelegramNotification("สั่งจ่ายยาตลับที่ " + String(modIdx+1));
      } else {
        sendTelegramNotification("ระบุตลับยา 1-6 เช่น /dispense 1");
      }
    } else {
       sendTelegramNotification("ระบุตลับยา 1-6 เช่น /dispense 1");
    }
  }
  else if (command == "/status" || command == "สถานะ") {
    DateTime now = rtc.now();
    String msg = String(MSG_SYSTEM_STATUS) + "\n";
    msg += "เวลา: " + formatTime(now.hour(), now.minute()) + "\n";
    for(int i=0; i<6; i++) {
      msg += String(i+1) + ". " + modules[i].name + " (" + String(modules[i].count) + ")\n";
    }
    msg += String(MSG_LABEL_WIFI) + getWiFiSSID();
    sendTelegramNotification(msg);
  }
  else if (command == "/help" || command == "ช่วย") {
    String msg = String(MSG_COMMAND_LIST) + "\n";
    msg += "/dispense [1-6] - จ่ายยาตลับ N\n";
    msg += "/status - ดูสถานะยา\n";
    sendTelegramNotification(msg);
  }
}

// ============================================
// Button Handling (Confirmation & Manual)
// ============================================
void buttonLoop() {
  static unsigned long buttonPressStart = 0;
  static bool buttonHandled = false;
  
  if (digitalRead(SWITCH_PIN) == LOW) {
    if (buttonPressStart == 0) {
      buttonPressStart = millis();
      buttonHandled = false;
    }
    
    unsigned long pressDuration = millis() - buttonPressStart;
    
    // กดค้าง 5 วินาที = รีเซ็ต WiFi
    if (!buttonHandled && pressDuration > WIFI_RESET_HOLD_TIME) {
      LOG_WARN("[Button] WiFi Reset triggered!");
      resetWiFi();
      buttonHandled = true;
    }
  } else {
    // ปล่อยปุ่ม
    if (buttonPressStart > 0 && !buttonHandled) {
      unsigned long pressDuration = millis() - buttonPressStart;
      
      // กดสั้น (50ms - 1s)
      if (pressDuration > 50 && pressDuration < 1000) {
        
        // 1. ถ้ามีคิวรอจ่ายยา (Pending Confirmation)
        if (pendingDispenseMask > 0) {
          LOG_INFO("[Button] Confirmed Dispense!");
          updateShadow("dispensing_status", "confirmed");
          
          for(int i=0; i<6; i++) {
            if (pendingDispenseMask & (1 << i)) {
               dispensePill(i, "Confirmed Schedule");
               
               // Decrement count
               if (modules[i].count > 0) {
                 modules[i].count--;
                 updateShadow("med" + String(i+1) + "_count", String(modules[i].count));
               }
            }
          }
          // Clear mask
          pendingDispenseMask = 0;
          
        } else {
          // 2. ถ้าไม่มีคิว -> Manual Dispense (Test Module 1)
          LOG_INFO("[Button] Manual dispense Module 1!");
          dispensePill(0, "Manual Button");
        }
      }
    }
    buttonPressStart = 0;
    buttonHandled = false;
  }
}

// ============================================
// Setup (No delay!)
// ============================================
void setup() {
  Serial.begin(115200);
  
  // Non-blocking Serial wait
  unsigned long serialStart = millis();
  while (!Serial && millis() - serialStart < 1000) {
    // รอ Serial ไม่เกิน 1 วินาที
  }
  
  LOG_INFO("=== ESP32 Medicine Dispenser v%s ===", FIRMWARE_VERSION);
  LOG_INFO("[System] No delay() - Skill Compliant");
  
  // I2C Setup
  Wire.begin(I2C_SDA, I2C_SCL);
  Wire.setClock(100000);
  
  // Button Setup
  pinMode(SWITCH_PIN, INPUT_PULLUP);
  
  // Initialize Modules
  dispenserSetup();
  schedulerSetup();
  
  // WiFi & Offline Queue
  wifiSetup();
  offlineSetup();
  
  // NTP & Time (if online)
  if (isSystemOnline()) {
    configTime(GMT_OFFSET_SEC, DAYLIGHT_OFFSET_SEC, NTP_SERVER);
    syncRTCWithNTP();
  } else {
    LOG_INFO("[System] Using RTC time (offline)");
  }
  
  // NETPIE
  netpieSetup();
  setScheduleCallback(onScheduleUpdate);
  setDispenseCallback(onNetpieDispense);
  
  // Telegram
  telegramSetup();
  setTelegramCommandCallback(onTelegramCommand);
  
  // Dispenser Callback
  setDispenseCompleteCallback(onDispenseComplete);
  
  // Schedule Callback
  setScheduleTriggerCallback(onScheduleTrigger);
  
  // Startup notification (if online)
  if (isSystemOnline()) {
    sendTelegramNotification(String(MSG_SYSTEM_ONLINE) + " (6 Modules Ready)");
  }
  
  LOG_INFO("=== READY (Mode: %s) ===", isSystemOnline() ? "ONLINE" : "OFFLINE");
}

// ============================================
// Main Loop (Non-blocking)
// ============================================
void loop() {
  // Non-blocking loop timing
  static unsigned long lastLoopTime = 0;
  
  if (millis() - lastLoopTime < LOOP_INTERVAL) {
    return;
  }
  lastLoopTime = millis();
  
  // --- Connectivity Check ---
  checkConnectivity();
  
  // --- Module Loops ---
  if (isSystemOnline()) {
    netpieLoop();
    telegramLoop();
  }
  
  // ทำงานได้ทั้ง online/offline
  dispenserLoop();
  schedulerLoop();
  
  // --- Button (ทำงานได้เสมอ) ---
  buttonLoop();
}
