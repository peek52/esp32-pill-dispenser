      }
      
      if (dose3.active) {
        response += "🌆 เย็น: " + String(dose3.hour) + ":" + (dose3.minute < 10 ? "0" : "") + String(dose3.minute);
        response += " (" + dose3.label + ")\n";
      }
      
      if (dose4.active) {
        response += "🌙 ก่อนนอน: " + String(dose4.hour) + ":" + (dose4.minute < 10 ? "0" : "") + String(dose4.minute);
        response += " (" + dose4.label + ")\n";
      }
      
      if (!dose1.active && !dose2.active && !dose3.active && !dose4.active) {
        response += "ยังไม่มีตารางการจ่ายยา";
      }
      
      bot.sendMessage(chat_id, response, "Markdown");
    }
    
    // คำสั่ง /help
    else if (text == "/help" || text == "/start") {
      String response = "🤖 *คำสั่งที่ใช้ได้:*\n\n";
      response += "/schedule - ดูตารางการจ่ายยา\n";
      response += "/check - เช็คตารางการจ่ายยา\n";
      response += "/help - แสดงคำสั่งนี้\n";
      bot.sendMessage(chat_id, response, "Markdown");
    }
    
    // คำสั่งไม่รู้จัก
    else {
      bot.sendMessage(chat_id, "❓ ไม่เข้าใจคำสั่ง พิมพ์ /help เพื่อดูคำสั่งที่ใช้ได้", "");
    }
  }
}

// === CHECK SCHEDULE (4 doses with 3-min warning) ===
void checkSchedule() {
  if (!scheduleEnabled) return;
  
  DateTime now = rtc.now();
  int h = now.hour();
  int m = now.minute();
  int s = now.second();

  if (s != 0) return;
  
  Serial.printf("[CHECK] %02d:%02d | Schedule: %s\n", h, m, scheduleEnabled ? "ON" : "OFF");

  // สร้าง array ของ 4 doses
  TimeSlot* doses[] = {&dose1, &dose2, &dose3, &dose4};
  bool* notifFlags[] = {&notifState.dose1_3min_sent, &notifState.dose2_3min_sent, 
                        &notifState.dose3_3min_sent, &notifState.dose4_3min_sent};
  
  for (int i = 0; i < 4; i++) {
    TimeSlot* d = doses[i];
    if (!d->active) continue;
    
    int minutesUntil = (d->hour * 60 + d->minute) - (h * 60 + m);
    
    // แจ้งเตือน 3 นาที
    if (minutesUntil == 3 && !(*notifFlags[i])) {
      sendTelegramNotification("⏰ อีก 3 นาที: " + medicineName + " (" + d->label + ")");
      *notifFlags[i] = true;
    }
    
    // Reset flag
    if (minutesUntil < 0) {
      *notifFlags[i] = false;
    }
    
    // ถึงเวลาจ่าย
    if (h == d->hour && m == d->minute) {
      Serial.printf(">>> TIME TO DISPENSE: Dose %d\n", i+1);
      dispensePill(medicineName + " - " + d->label);
    }
  }
}

void loop() {
  // === ตรวจสอบ WiFi และ NETPIE ===
  if (WiFi.status() == WL_CONNECTED) {
    if (!client.connected()) connectNETPIE();
    client.loop();
    
    if (millis() - lastNtpSync > NTP_SYNC_INTERVAL) {
      syncRTCWithNTP();
    }
  }

  // === ตรวจสอบการเชื่อมต่อ (Online/Offline) ===
  if (millis() - lastConnectionCheck > 30000) {  // ทุก 30 วินาที
    bool isConnected = (WiFi.status() == WL_CONNECTED);
    
    if (!wasConnected && isConnected) {
      // เพิ่งเชื่อมกลับ
      sendTelegramNotification("🟢 ระบบกลับมาออนไลน์: " + medicineName);
      Serial.println("🟢 Back Online!");
    } else if (wasConnected && !isConnected) {
      // เพิ่งขาดการเชื่อมต่อ
      Serial.println("⚠️ WiFi Disconnected!");
    }
    
    wasConnected = isConnected;
    lastConnectionCheck = millis();
  }

  // === เช็ค Telegram Messages ===
  if (WiFi.status() == WL_CONNECTED && millis() - lastBotCheck > BOT_CHECK_INTERVAL) {
    handleTelegramMessages();
    lastBotCheck = millis();
  }

  // === เช็คตารางเวลา ===
  checkSchedule(); 

  // === ปุ่มกด Manual ===
  if (digitalRead(SWITCH_PIN) == LOW) {
    delay(100);
    if (digitalRead(SWITCH_PIN) == LOW) {
      delay(50);
      if (digitalRead(SWITCH_PIN) == LOW) {
        Serial.println(">>> Manual Button!");
        dispensePill("Manual Button - " + medicineName);
        while(digitalRead(SWITCH_PIN) == LOW) delay(10);
        delay(100);
      }
    }
  }
  
  delay(100);
}
