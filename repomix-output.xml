                <input type="text" id="n-${m.id}" class="mod-name-input" placeholder="ระบุชื่อยา..." onchange="upd(${m.id})">
                <div class="slots-row">${renderSlots(m.id)}</div>
            </div>`;
            });
            document.getElementById('module-container').innerHTML = html;

            // Loop
            setInterval(syncLoop, 1000);
        }

        function renderSlots(id) {
            return SLOT_LABELS.map((s, i) =>
                `<div id="s-${id}-${i}" class="slot-pill" onclick="tog(${id},${i})">${s}</div>`
            ).join('');
        }

        // --- LOGIC ---
        function step(id, d) {
            let m = modules[id - 1];
            m.count = Math.max(0, (m.count || 0) + d);
            refresh(id);
        }
        function tog(id, b) {
            modules[id - 1].slots ^= (1 << b);
            refresh(id);
        }
        function upd(id) {
            modules[id - 1].name = document.getElementById('n-' + id).value;
        }
        function refresh(id) {
            let m = modules[id - 1];
            document.getElementById('c-' + id).innerText = m.count;
            for (let j = 0; j < 7; j++) {
                let el = document.getElementById(`s-${id}-${j}`);
                if (m.slots & (1 << j)) el.classList.add('active'); else el.classList.remove('active');
