#include "offline_module.h"
#include "wifi_module.h"
#include "netpie.h"
#include "config.h"
#include "logging.h"
#include "scheduler.h" // For rtc
#include <vector>

struct OfflineEvent {
  unsigned long timestamp;
  String eventType;
  String data;
};

static std::vector<OfflineEvent> offlineQueue;

// Helper to access RTC from scheduler (extern in scheduler.h usually, or we need to access it)
// We need to make sure 'rtc' is accessible or include "scheduler.h" and ensure rtc is declared external there.
// Checking scheduler.cpp/h... main.cpp included "scheduler.h".
// Let's assume scheduler.h declares `extern RTC_DS3231 rtc;` or similar. 
// If not, we might need timestamp from other source.
// But scheduler.cpp has `RTC_DS3231 rtc;`.
// We should check scheduler.h content first or ensure it is extern.
// For now, I will use rtc.now() assuming it's available via scheduler.h
// Let's verify scheduler.h in next step if compilation fails, but based on main.cpp usage it seems rtc is available? 
// Actually main.cpp includes scheduler.h but `rtc` was used in `addToOfflineQueue` in main.cpp.
// `rtc` is defined in scheduler.cpp. `main.cpp` used `rtc.now()`.
// So `scheduler.h` must have `extern RTC_DS3231 rtc;`.

void offlineSetup() {
  // Nothing specific to setup for vector
}

void addToOfflineQueue(String type, String data) {
  if (offlineQueue.size() < 50) {
    OfflineEvent event;
    // We need 'rtc' object. 
    // If rtc is not global extern, we might need a getter for timestamp.
    // Let's try to include scheduler.h and use rtc.
    // If that fails, we can use millis() as relative time or 0.
    extern RTC_DS3231 rtc; 
    
    event.timestamp = rtc.now().unixtime();
    event.eventType = type;
    event.data = data;
    offlineQueue.push_back(event);
    LOG_DEBUG("[Offline] Queued: %s", type.c_str());
  }
}

void syncOfflineQueue() {
  if (!isSystemOnline() || offlineQueue.empty()) return;
  
  LOG_INFO("[Offline] Syncing %d queued events...", offlineQueue.size());
  
  for (auto& event : offlineQueue) {
    updateShadow(event.eventType, event.data);
    // Add small delay to prevent flooding?
    // delay(50); // Removed for non-blocking compliance. Network stack handles this. 
  }
  offlineQueue.clear();
  LOG_INFO("[Offline] Queue synced!");
}

void updateShadowOfflineAware(String status, String detail) {
  if (!isSystemOnline()) {
    addToOfflineQueue(status, detail);
    return;
  }
  updateShadow(status, detail);
}
