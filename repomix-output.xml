                            <option value="before">ก่อนอาหาร</option>
                            <option value="after" selected>หลังอาหาร</option>
                        </select></div>
                </div>
                <!-- Bedtime -->
                <div class="dose-card">
                    <div class="dose-header"><span class="dose-icon">🌙</span><span
